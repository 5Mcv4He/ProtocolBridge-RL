// Project-owned APB monitor/model; commercial protocol implementation external.
`timescale 1ns/1ps
`include "uvm_macros.svh"
`include "svt_apb.uvm.pkg"
`include "svt_apb_if.svi"
import uvm_pkg::*;
import svt_uvm_pkg::*;
import svt_apb_uvm_pkg::*;

class register_sequence extends svt_apb_master_base_sequence;
 `uvm_object_utils(register_sequence)
 function new(string name="register_sequence");super.new(name);endfunction
 virtual task body();
  svt_apb_master_transaction t;
  super.body();
  for(int i=0;i<tb.plan_count;i++) begin
   if(tb.operations[i]==2) tb.apply_reset();
   else begin
    tb.issued_index=i;
    t=svt_apb_master_transaction::type_id::create($sformatf("request_%0d",i));
    start_item(t);t.cfg=cfg;t.address=tb.addresses[i];
    t.xact_type=tb.operations[i]?svt_apb_transaction::WRITE:svt_apb_transaction::READ;
    t.data=tb.words[i];t.pstrb=tb.strobes[i];
    finish_item(t);get_response(rsp);
   end
  end
 endtask
endclass
class register_test extends uvm_test;
 `uvm_component_utils(register_test)
 svt_apb_system_env apb;
 function new(string name,uvm_component parent);super.new(name,parent);endfunction
 function void build_phase(uvm_phase phase);
  svt_apb_system_configuration c;
  super.build_phase(phase);c=new("master_config");
  c.paddr_width=svt_apb_system_configuration::PADDR_WIDTH_32;
  c.pdata_width=svt_apb_system_configuration::PDATA_WIDTH_32;
  c.apb4_enable=1;c.create_sub_cfgs(1);c.is_active=1;c.slave_cfg[0].is_active=0;
  c.enable_xml_gen=0;c.slave_cfg[0].enable_xml_gen=0;
  uvm_config_db#(svt_apb_system_configuration)::set(this,"apb","cfg",c);
  apb=svt_apb_system_env::type_id::create("apb",this);
 endfunction
 task run_phase(uvm_phase phase);
  register_sequence seq;
  phase.raise_objection(this);wait(tb.rst_n);repeat(4) @(posedge tb.clk);
  seq=register_sequence::type_id::create("seq");seq.start(apb.master.sequencer);
  repeat(8) @(posedge tb.clk);
  if(tb.checked!=tb.expected_transfers || tb.reset_count!=tb.expected_resets)
   `uvm_fatal("PB_INFRA","Incomplete actual transfer/reset activity")
  $display("PB_REGISTER_DONE checked=%0d resets=%0d waits=%0d",tb.checked,tb.reset_count,tb.wait_cycles);
  phase.drop_objection(this);
 endtask
endclass
module tb;
 `include "register_config.svh"
 logic clk=0,rst_n=0;always #5 clk=~clk;
 svt_apb_if bus();wire[31:0]prdata;wire pready,pslverr;
 assign bus.pclk=clk;assign bus.presetn=rst_n;
 assign bus.slave_if[0].prdata=prdata;assign bus.slave_if[0].pready=pready;assign bus.slave_if[0].pslverr=pslverr;
 bridge dut(clk,rst_n,bus.psel[0],bus.penable,bus.pwrite,bus.paddr,bus.pwdata,bus.pstrb,prdata,pready,pslverr);
 integer operations[4096],addresses[4096],words[4096],strobes[4096];
 int plan_count=0,expected_transfers=0,expected_resets=1,issued_index=-1;
 int checked=0,reset_count=0,wait_cycles=0,current_waits=0,active_target=-1;
 bit in_reset=0,active=0,activity_reported=0;
 logic[31:0] model[REG_COUNT],saved_addr,saved_data;
 logic[3:0] saved_strobe;logic saved_write;
 bit strobe_seen[REG_COUNT][16];bit read_seen[REG_COUNT];
 function automatic integer target_for(logic[31:0]a);
  for(int i=0;i<REG_COUNT;i++) if(a===reg_address(i)) return i;
  return -1;
 endfunction
 function automatic logic[31:0] next_word(int i,logic[31:0] prior_value,logic[31:0]data,logic[3:0]strobe);
  logic[31:0] enable;
  enable=0;
  for(int lane=0;lane<4;lane++) if(strobe[lane]) enable[8*lane+:8]=8'hff;
  enable=enable & write_mask(i);
  case(mode(i))
   0:return (prior_value & ~enable)|(data & enable);
   1:return prior_value;
   2:return prior_value & ~(data & enable);
   default:return 32'hx;
  endcase
 endfunction
 `include "oracle_anchors.svh"
 task apply_reset();
  @(negedge clk);rst_n=0;repeat(3) @(negedge clk);rst_n=1;
  repeat(4) @(posedge clk);
 endtask
 always @(posedge clk) begin
  if(!rst_n) begin
   for(int i=0;i<REG_COUNT;i++) model[i]=reset_word(i);
   if(!in_reset) reset_count++;
   in_reset=1;active=0;current_waits=0;
   if(pready!==0) `uvm_error("PB_TIMING","PREADY not low in reset")
  end else begin
   in_reset=0;
   if(!bus.psel[0] || !bus.penable) begin
    if(pready!==0) `uvm_error("PB_TIMING","PREADY not low outside Access")
   end
   if(bus.psel[0] && !bus.penable) begin
    if(active) `uvm_error("PB_TIMING","New Setup before prior completion")
    if(!activity_reported) begin $display("PB_REGISTER_ACTIVITY");activity_reported=1;end
    active=1;current_waits=0;saved_addr=bus.paddr;saved_data=bus.pwdata;saved_strobe=bus.pstrb;saved_write=bus.pwrite;
    active_target=target_for(bus.paddr);
    if(issued_index<0 || saved_addr!==addresses[issued_index] || saved_write!==operations[issued_index][0])
     `uvm_fatal("PB_INFRA","Actual VIP request differs from scheduled stimulus")
    if(saved_write && (saved_data!==words[issued_index] || saved_strobe!==strobes[issued_index][3:0]))
     `uvm_fatal("PB_INFRA","Actual VIP write payload differs from scheduled stimulus")
   end
   if(bus.psel[0] && bus.penable) begin
    if(!active) `uvm_error("PB_TIMING","Access without a corresponding Setup")
    if(bus.paddr!==saved_addr || bus.pwrite!==saved_write || (saved_write && (bus.pwdata!==saved_data || bus.pstrb!==saved_strobe)))
     `uvm_fatal("PB_INFRA","Trusted stimulus changed while Access pending")
    if(pready===0) begin current_waits++;wait_cycles++;end
    else if(pready===1) begin
     if(current_waits!=ACCESS_WAITS) `uvm_error("PB_TIMING","Wrong Access wait-edge count")
     if(pslverr !== (active_target<0)) `uvm_error("PB_FUNCTION","Mapped/unmapped response identity mismatch")
     if(active_target<0) begin
      if(prdata!==0) `uvm_error("PB_FUNCTION","Unmapped response data must be zero")
     end else if(saved_write) begin
      model[active_target]=next_word(active_target,model[active_target],saved_data,saved_strobe);
      strobe_seen[active_target][saved_strobe]=1;
     end else begin
      if(prdata!==model[active_target]) `uvm_error("PB_FUNCTION","Register data/state mismatch")
      read_seen[active_target]=1;
     end
     checked++;active=0;current_waits=0;
    end else `uvm_error("PB_TIMING","Unknown PREADY")
   end
  end
 end
 initial begin
  integer f,rc,op;logic[31:0]a,d;logic[3:0]s;string filename;
  if(!$value$plusargs("vectors=%s",filename)) $fatal(1,"PB_INFRA missing vectors");
  f=$fopen(filename,"r");if(!f) $fatal(1,"PB_INFRA cannot open vectors");
  while(!$feof(f)) begin
   rc=$fscanf(f,"%d %h %h %h\n",op,a,d,s);
   if(rc==-1) break;
   if(rc!=4 || op<0 || op>2 || plan_count>=4096) $fatal(1,"PB_INFRA invalid vector row");
   operations[plan_count]=op;addresses[plan_count]=a;words[plan_count]=d;strobes[plan_count]=s;plan_count++;
   if(op==2) expected_resets++;else expected_transfers++;
  end
  $fclose(f);if(!expected_transfers) $fatal(1,"PB_INFRA empty stimulus");
 end
 initial begin repeat(8) @(negedge clk);rst_n=1;end
 initial begin repeat(200000) @(posedge clk);$display("PB_REGISTER_TIMEOUT");$finish;end
 final begin
  integer observed_count=0;
  for(int i=0;i<REG_COUNT;i++) begin
   if(read_seen[i]) observed_count++;
   for(int s=0;s<16;s++) if(strobe_seen[i][s]) observed_count++;
  end
  $display("PB_REGISTER_COVERAGE observed=%0d required=%0d",observed_count,17*REG_COUNT);
 end
 initial begin
  uvm_config_db#(svt_apb_vif)::set(null,"uvm_test_top.apb","vif",bus);
  run_test("register_test");
 end
endmodule
