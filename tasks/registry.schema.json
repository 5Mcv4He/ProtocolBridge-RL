{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProtocolBridge task catalog v1",
  "type": "object",
  "required": [
    "schema_version",
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "capabilities",
          "environment",
          "initial_rtl",
          "metadata",
          "policies",
          "protocols",
          "quality_kind",
          "reward_contract",
          "spec",
          "task_id",
          "title",
          "verifier",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "metadata": {
            "type": "string"
          },
          "spec": {
            "type": "string"
          },
          "initial_rtl": {
            "type": "string"
          },
          "verifier": {
            "type": "string"
          },
          "environment": {
            "type": "object",
            "required": [
              "reset",
              "test",
              "submit"
            ],
            "additionalProperties": false,
            "properties": {
              "reset": {
                "type": "string"
              },
              "test": {
                "type": "string"
              },
              "submit": {
                "type": "string"
              }
            }
          },
          "quality_kind": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "protocols": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "policies": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reward_contract": {
            "type": "string"
          }
        }
      }
    }
  }
}
